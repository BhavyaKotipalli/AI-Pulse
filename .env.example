# ─────────────────────────────────────────────────────────────────────────────
# AI Pulse — environment configuration
# Copy to .env.local and fill in what you need. Everything is optional for local
# demo mode: with no variables set the app uses embedded Postgres (PGlite) and the
# offline mock AI provider.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Postgres with the pgvector extension (Neon, Supabase, or `docker compose up`).
# Leave unset to use embedded PGlite stored in PGLITE_DIR.
# DATABASE_URL=postgres://ai_pulse:ai_pulse@localhost:5432/ai_pulse
# Direct (non-pooled) URL used for migrations at build time (Neon provides both).
# DATABASE_URL_UNPOOLED=
# DATABASE_POOL_MAX=10
# PGLITE_DIR=.data/pglite

# ── Seed data ───────────────────────────────────────────────────────────────
# demo (default): starter dataset with simulated dates, for local exploration.
# reference: production — curated reference data only, no simulated news.
# SEED_MODE=demo

# ── Demo mode ───────────────────────────────────────────────────────────────
# true (default): anonymous visitors act as a shared demo guest.
# DEMO_MODE=true

# ── Authentication (Better Auth) ────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# Optional GitHub OAuth (callback: <BETTER_AUTH_URL>/api/auth/callback/github)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── AI providers ────────────────────────────────────────────────────────────
# mock | anthropic | openai | gemini   (real adapters land in Phase 3)
# AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OpenAI-compatible endpoint, e.g. Ollama: http://localhost:11434/v1
# OPENAI_BASE_URL=
# GEMINI_API_KEY=
# Strong-tier analysis is skipped once the estimated daily spend exceeds this.
# AI_DAILY_BUDGET_USD=1

# ── Data sources (Phase 2) ──────────────────────────────────────────────────
# Raises GitHub API limits from 60 to 5,000 requests/hour.
# GITHUB_TOKEN=

# ── Operations ──────────────────────────────────────────────────────────────
# Bearer token required by /api/cron/* (min 16 chars). Vercel Cron sends it automatically.
# CRON_SECRET=
# Comma-separated emails allowed to run jobs from Settings in production.
# ADMIN_EMAILS=
# LOG_LEVEL=info
