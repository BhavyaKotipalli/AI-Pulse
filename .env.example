# ─────────────────────────────────────────────────────────────────────────────
# AI Pulse — environment configuration
# Copy to .env.local and fill in what you need. Everything is optional for local
# use: with nothing set the app runs on embedded Postgres (PGlite) and an offline
# mock AI provider.
#
# Never commit real keys. Put them in .env.local (git-ignored) for local use and in
# your host's environment variables (Vercel → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Postgres with the pgvector extension (Supabase, Neon, or `docker compose up`).
# Leave unset to use embedded PGlite stored in PGLITE_DIR.
# DATABASE_URL=postgres://ai_pulse:ai_pulse@localhost:5432/ai_pulse
# Direct (non-pooled) URL used for migrations at build time, if your host provides one.
# DATABASE_URL_UNPOOLED=
# DATABASE_POOL_MAX=10
# TLS for remote databases: default encrypts without verifying the chain; strict verifies; off disables.
# DATABASE_SSL=strict
# PGLITE_DIR=.data/pglite

# ── Seed data ───────────────────────────────────────────────────────────────
# demo (default): starter dataset with simulated dates, for local exploration.
# reference: production — curated reference data only, no simulated news.
# SEED_MODE=demo

# ── Demo mode ───────────────────────────────────────────────────────────────
# true (default): anonymous visitors act as a shared demo guest.
# DEMO_MODE=true

# ── Authentication (Better Auth) ────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# Optional GitHub OAuth (callback: <BETTER_AUTH_URL>/api/auth/callback/github)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── AI provider (all options below have free tiers) ─────────────────────────
# mock        offline, no key (default)
# gemini      Google AI Studio key — recommended: free tier covers text + embeddings
# groq        Groq key — fast open models, free tier (no embeddings)
# openrouter  OpenRouter key — set AI_FAST_MODEL / AI_STRONG_MODEL to ":free" models
# openai      any OpenAI-compatible endpoint via OPENAI_BASE_URL (e.g. local Ollama)
# AI_PROVIDER=gemini

# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Get a key at https://console.groq.com/keys
# GROQ_API_KEY=
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1

# Model overrides (defaults: gemini → gemini-3.5-flash-lite / gemini-3.8-flash,
# groq → openai/gpt-oss-20b / openai/gpt-oss-120b).
# AI_FAST_MODEL=
# AI_STRONG_MODEL=

# Embeddings: auto uses Gemini when GEMINI_API_KEY is set (even if AI_PROVIDER is
# groq), otherwise offline hashing. Changing this re-embeds items on the next
# enrichment run.
# EMBEDDING_PROVIDER=auto
# AI_EMBEDDING_MODEL=gemini-embedding-001
# Minimum cosine similarity for a vector-only search match (model dependent).
# AI_RELEVANCE_FLOOR=0.6

# Free-tier guards. Check your real limits in the provider console and adjust.
# AI_REQUESTS_PER_MINUTE=8
# AI_DAILY_REQUEST_LIMIT=300

# ── Data sources ────────────────────────────────────────────────────────────
# Fine-grained GitHub token with no scopes; raises API limits (public data only).
# GITHUB_TOKEN=

# ── Operations ──────────────────────────────────────────────────────────────
# Bearer token required by /api/cron/* (min 16 chars). Vercel Cron sends it
# automatically; the GitHub Actions scheduler reads it from repository secrets.
# CRON_SECRET=
# Comma-separated emails allowed to run jobs from Settings in production.
# ADMIN_EMAILS=
# LOG_LEVEL=info
