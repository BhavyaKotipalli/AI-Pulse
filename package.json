    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
